    "protocol": "lapsimpro",
    "action": "paint/install",
    "pack_href": "lapsimpro://paint/install?pack=lapsimpro-house-gt3",
    "fallback": "./download.html?paint=1",
    "paint_root": "{Documents}/iRacing/paint",
    "file_pattern": {
      "car": "car_{customer_id}.tga",
      "car_spec": "car_spec_{customer_id}.tga",
      "car_num": "car_num_{customer_id}.tga",
      "decal": "decal_{customer_id}.tga"
    },
    "notes": "Download buttons open the LapSimPro overlay paint installer. The overlay registers lapsimpro://paint/install and copies TGA files into Documents/iRacing/paint/<car_path>/."
  },
  "asset_drop": {
    "root": "assets/liveries/{car_path}/",
    "required": ["car.tga"],
    "optional": ["car_spec.tga", "car_num.tga", "decal.tga", "preview.svg", "preview.png"],
    "readme": "assets/liveries/README.md",
    "notes": "Drop 24-bit RLE TGAs here. Overlay installer renames them to car_<customerId>.tga in the matching iRacing paint folder. Set files.car and assets_ready true after a drop."
  },
