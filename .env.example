# Copy to .env for local API + Stripe entitlement checks.
# Never commit real keys.

# Required for signed session cookies / device tokens
LAPSIMPRO_SECRET=change-me-to-a-long-random-string

# SQLite path (default: ./data/lapsimpro.db)
LAPSIMPRO_DB=data/lapsimpro.db

# Public marketing site (Stripe redirects + magic-link landing)
LAPSIMPRO_PUBLIC_URL=http://127.0.0.1:8787

# Public API origin. Same as PUBLIC_URL locally. In production this is the Render/Fly host
# or https://api.lapsimpro.com after the CNAME is live.
LAPSIMPRO_API_URL=http://127.0.0.1:8787

# Installer URL returned only when the account has an active subscription
LAPSIMPRO_DOWNLOAD_URL=https://github.com/immortalesrevinu-art/iracing-coach-overlay/releases/download/v0.1.0/LapSimPro-Setup.zip

# Local/dev only: treat every logged-in user as subscribed (Starter).
# Leave unset or 0 when checking real Stripe entitlements.
LAPSIMPRO_DEV_ENTITLEMENT=1

# Stripe (restricted key preferred: rk_test_... / rk_live_...)
# Sandbox products are empty today; live catalog is Starter/Pro/Elite.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live monthly prices on account acct_1UGOgnPVazkD4Gpu
STRIPE_PRICE_STARTER=price_1UGOsMPVazkD4GpuxvLFjoCJ
STRIPE_PRICE_PRO=price_1UGOsNPVazkD4GpuP7jWZuax
STRIPE_PRICE_ELITE=price_1UGOsMPVazkD4GpuqAtr8Muv

# Optional: comma-separated origins for the static GitHub Pages site
LAPSIMPRO_CORS_ORIGINS=https://lapsimpro.com,https://www.lapsimpro.com,http://lapsimpro.com,http://www.lapsimpro.com,http://127.0.0.1:8787,http://localhost:8787

# Training points (overlay + server use the same defaults)
BRAKE_HIT_WINDOW_M=12
BRAKE_TIME_WINDOW_S=0.35
BRAKE_CLOSE_WINDOW_M=20
BRAKE_THRESHOLD=0.2
BRAKE_HIT_POINTS=10
BRAKE_CLOSE_POINTS=5
LAP_PB_POINTS=50
LAP_IMPROVE_POINTS=25
